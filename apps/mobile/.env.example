# Template for apps/mobile/.env:
#   cp apps/mobile/.env.example apps/mobile/.env
#
# ⚠️ Every EXPO_PUBLIC_* variable is compiled INTO the app bundle — anyone
# who downloads the app can read it. NEVER put secrets (API keys, tokens)
# here. Secrets live only on the backend (apps/api/.env).

# Where the app finds our API.
#   iOS simulator:     http://localhost:3000
#   Android emulator:  http://10.0.2.2:3000
#   Physical phone:    http://<your-computer-LAN-IP>:3000 (and HOST=0.0.0.0 in the API)
EXPO_PUBLIC_API_URL=http://localhost:3000
