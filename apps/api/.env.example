# Template for apps/api/.env — copy it and fill in real values:
#   cp apps/api/.env.example apps/api/.env
# .env is git-ignored and blocked by the pre-commit hook. NEVER commit it,
# never paste its values into chats, issues or screenshots.

NODE_ENV=development

# Which network interface the API listens on.
#   127.0.0.1 — only this computer can reach it (safe default; works for the
#               iOS simulator).
#   0.0.0.0   — any device in your Wi-Fi can reach it. Use only temporarily,
#               when testing on a physical phone.
HOST=127.0.0.1
PORT=3000

# TMDB "API Read Access Token" (the long one, used as a Bearer token) —
# NOT the short "API Key". Get it at https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Generated by `pnpm setup:env` — no need to fill these in by hand.
# PostgreSQL connection (the local database from compose.yaml).
DATABASE_URL=
# Key that signs access tokens: at least 32 random bytes.
JWT_SECRET=

# Optional (defaults shown). Leave commented unless you need to change them.
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_TIMEOUT_MS=5000
# Wikidata's public SPARQL endpoint, for critics' scores (no key needed).
# Must use https; only tests point it at a local fake.
# WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
