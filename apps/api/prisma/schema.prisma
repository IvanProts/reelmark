// Database schema. Migrations live in ./migrations; see prisma.config.ts for the connection.

generator client {
  provider            = "prisma-client"
  // Generated by `pnpm db:generate`; git-ignored, never edited by hand.
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// An account. Phase 1 accounts are anonymous: the device holds a refresh token.
model User {
  id            String         @id @default(uuid()) @db.Uuid
  /// The chosen app language ("uk" or "en"); null until the user picks one.
  locale        String?        @db.VarChar(8)
  createdAt     DateTime       @default(now()) @map("created_at")
  decisions     Decision[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// A refresh token, stored only as its SHA-256 hash. Rotation keeps the familyId, so reuse of a
/// rotated token can revoke every token descended from the same sign-in.
model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hex-encoded SHA-256 of the token.
  tokenHash    String        @unique @map("token_hash") @db.Char(64)
  familyId     String        @map("family_id") @db.Uuid
  expiresAt    DateTime      @map("expires_at")
  /// Set when the token is rotated or its family is revoked.
  revokedAt    DateTime?     @map("revoked_at")
  /// The token issued when this one was last redeemed.
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("Rotation")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A TMDB movie the API has served in a deck. Written only from server-fetched, validated data.
model Movie {
  /// TMDB movie id.
  id           Int                @id
  /// TMDB image path, e.g. "/kqjL17yufvn9OVLyXYpvtyrFfak.jpg".
  posterPath   String             @map("poster_path") @db.VarChar(128)
  releaseYear  Int?               @map("release_year")
  /// TMDB average vote, rounded to one decimal, 0–10.
  rating       Float
  genreIds     Int[]              @map("genre_ids")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  translations MovieTranslation[]
  decisions    Decision[]

  @@map("movies")
}

/// Title and overview of a movie in one locale.
model MovieTranslation {
  movieId  Int    @map("movie_id")
  movie    Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  locale   String @db.VarChar(8)
  title    String
  /// Empty when TMDB has no description in this locale.
  overview String

  @@id([movieId, locale])
  @@map("movie_translations")
}

enum DecisionStatus {
  SEEN
  NOT_SEEN
  WANT

  @@map("decision_status")
}

/// How a user sorted a movie. One row per (user, movie), so saving is an upsert.
model Decision {
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   Int            @map("movie_id")
  movie     Movie          @relation(fields: [movieId], references: [id], onDelete: Restrict)
  status    DecisionStatus
  /// Only for SEEN: true = liked, false = disliked, null = no opinion given.
  liked     Boolean?
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@id([userId, movieId])
  // Library pages: one user's decisions of one status, newest first (keyset pagination).
  @@index([userId, status, updatedAt(sort: Desc), movieId(sort: Desc)])
  @@map("decisions")
}
