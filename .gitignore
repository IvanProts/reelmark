# ── Secrets: never commit ─────────────────────────────────────────
# Real values live only in .env files on your machine / in the hosting
# provider's secret store. Only the *.example templates are committed.
.env
.env.*
*.env
.envrc
!.env.example
# npm/pnpm registry auth tokens; our pnpm settings live in pnpm-workspace.yaml
.npmrc
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# ── Dependencies & build output ───────────────────────────────────
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
# Prisma Client, generated from apps/api/prisma/schema.prisma by `pnpm db:generate`
apps/api/src/generated/

# ── Tooling ───────────────────────────────────────────────────────
.DS_Store
.claude/settings.local.json
# Generated by the Codex desktop app when it imports a Claude Code session
# (machine-specific absolute paths)
.codex/
