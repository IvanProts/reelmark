{
  "name": "reelmark",
  "version": "0.1.0",
  "description": "Swipe-based movie library: track what you have seen and discover what to watch next.",
  "author": "Ivan Prots (https://github.com/IvanProts)",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "setup:env": "sh scripts/setup-local-env.sh",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @reelmark/api db:deploy",
    "dev:api": "pnpm --filter @reelmark/shared build && pnpm --filter @reelmark/api start:dev",
    "dev:mobile": "pnpm --filter @reelmark/shared build && pnpm --filter @reelmark/mobile start",
    "dev:api:lan": "sh scripts/dev-lan.sh api",
    "dev:mobile:lan": "sh scripts/dev-lan.sh mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "pnpm format:check && turbo run lint typecheck test test:e2e",
    "security:secrets": "gitleaks dir . --config .gitleaks-worktree.toml --redact --no-banner",
    "security:audit": "pnpm audit --prod",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "prettier": "^3.9.9"
  }
}
